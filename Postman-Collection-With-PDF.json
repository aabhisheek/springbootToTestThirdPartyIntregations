  "item": [
    {
      "name": "Email APIs",
      "item": [
        {
          "name": "Send Email via AWS SES (No Attachment)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"to\": \"recipient@example.com\",\n  \"subject\": \"Test Email from AWS SES\",\n  \"body\": \"<h1>Hello!</h1><p>This is a test email from AWS SES.</p>\"\n}"
            },
            "url": {
              "raw": "http://localhost:8080/api/email/send-ses",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "email", "send-ses"]
            }
          }
        },
