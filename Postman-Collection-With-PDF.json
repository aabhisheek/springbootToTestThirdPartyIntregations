              "mode": "raw",
              "raw": "{\n  \"to\": \"recipient@example.com\",\n  \"subject\": \"Invoice - Order #12345\",\n  \"body\": \"<html><body><h2>Invoice Attached</h2><p>Dear Customer,</p><p>Please find your invoice attached.</p></body></html>\",\n  \"attachments\": [\n    {\n      \"fileName\": \"invoice.pdf\",\n      \"contentType\": \"application/pdf\",\n      \"base64Content\": \"\"\n    }\n  ]\n}"
            },
            "url": {
